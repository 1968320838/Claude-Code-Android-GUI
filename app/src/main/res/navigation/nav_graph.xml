<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/chatFragment">

    <fragment
        android:id="@+id/sessionListFragment"
        android:name="com.claudebox.ui.chat.SessionListFragment"
        android:label="@string/sessions">
        <action
            android:id="@+id/action_sessionList_to_chat"
            app:destination="@id/chatFragment" />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.claudebox.ui.chat.ChatFragment"
        android:label="@string/nav_chat">
        <action
            android:id="@+id/action_chat_to_sessionList"
            app:destination="@id/sessionListFragment" />
    </fragment>

    <fragment
        android:id="@+id/terminalFragment"
        android:name="com.claudebox.ui.terminal.TerminalFragment"
        android:label="@string/nav_terminal" />

    <fragment
        android:id="@+id/filesFragment"
        android:name="com.claudebox.ui.files.FilesFragment"
        android:label="@string/nav_files" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.claudebox.ui.settings.SettingsFragment"
        android:label="@string/nav_settings" />

</navigation>
